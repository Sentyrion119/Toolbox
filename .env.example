# Google AdSense
# Copier ce fichier en .env.local et remplir les valeurs
# (ne jamais committer .env.local)

# Votre Publisher ID AdSense (format : ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX

# Slot ID pour le format Leaderboard (728x90)
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=XXXXXXXXXX

# Slot ID pour le format Rectangle (300x250)
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=XXXXXXXXXX
